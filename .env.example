# Copy to .env.local and fill in. Never commit real secrets.

# ─── MongoDB ────────────────────────────────────────────────
# Local: mongodb://127.0.0.1:27017/voca
# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/voca
MONGODB_URI=mongodb://127.0.0.1:27017/voca

# ─── NextAuth ───────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── NVIDIA NIM (AI chat + word helper) ─────────────────────
# Get a key (starts with nvapi-) at https://build.nvidia.com
NVIDIA_API_KEY=
# Model ID from the NVIDIA catalog
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# ─── Google sign-in (OPTIONAL) ──────────────────────────────
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
# Leave blank to disable the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

